# Copy this file to .env and fill in real values. Never commit .env itself.
# Using OpenRouter's free, OpenAI-compatible endpoint:
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=inclusionai/ling-3.0-flash:free
# Comma-separated list of allowed frontend origins in production, e.g.
# ALLOWED_ORIGINS=https://your-app.awsapprunner.com
ALLOWED_ORIGINS=*
